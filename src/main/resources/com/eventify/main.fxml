<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eventify.MainController"
            fx:id="root"
            prefWidth="1200"
            prefHeight="780"
            stylesheets="@style.css">

    <top>
        <VBox spacing="12" styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="Eventify" styleClass="brand"/>

                <Label text="Event Management &amp; Coordination"
                       styleClass="subtitle"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="userLabel"/>

                <Button text="Sign out"
                        onAction="#onLogout"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Selected event:" minWidth="-Infinity"/>

                <ComboBox fx:id="eventBox"
                          prefWidth="380"
                          minWidth="240"
                          onAction="#onEventChanged"/>

                <Button text="Refresh"
                        minWidth="-Infinity"
                        onAction="#onRefresh"/>

                <Label text="This selection controls registrations, schedule, tasks and ranking."
                       wrapText="true"
                       styleClass="muted"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>

                <Tab text="Dashboard">
                    <content>
                        <VBox spacing="18" styleClass="page">
                            <Label text="Dashboard"
                                   styleClass="page-title"/>

                            <Label text="A central overview of your local Eventify workspace."
                                   styleClass="muted"/>

                            <HBox spacing="16">
                                <VBox spacing="8"
                                      styleClass="stat-card"
                                      HBox.hgrow="ALWAYS">
                                    <Label text="TOTAL EVENTS"/>
                                    <Label fx:id="eventCountLabel"
                                           text="0"
                                           styleClass="stat-number"/>
                                </VBox>

                                <VBox spacing="8"
                                      styleClass="stat-card"
                                      HBox.hgrow="ALWAYS">
                                    <Label text="UPCOMING EVENTS"/>
                                    <Label fx:id="upcomingCountLabel"
                                           text="0"
                                           styleClass="stat-number"/>
                                </VBox>

                                <VBox spacing="8"
                                      styleClass="stat-card"
                                      HBox.hgrow="ALWAYS">
                                    <Label text="TOTAL REGISTRATIONS"/>
                                    <Label fx:id="registrationCountLabel"
                                           text="0"
                                           styleClass="stat-number"/>
                                </VBox>

                                <VBox spacing="8"
                                      styleClass="stat-card"
                                      HBox.hgrow="ALWAYS">
                                    <Label text="PENDING TASKS"/>
                                    <Label fx:id="pendingCountLabel"
                                           text="0"
                                           styleClass="stat-number"/>
                                </VBox>
                            </HBox>

                            <Label text="Selected event"
                                   styleClass="section-title"/>

                            <Label fx:id="selectedEventLabel"
                                   text="No event selected"
                                   wrapText="true"/>

                            <Label text="Upcoming scheduled activities"
                                   styleClass="section-title"/>

                            <TextArea fx:id="upcomingArea"
                                      editable="false"
                                      wrapText="true"
                                      VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Events">
                    <content>
                        <VBox spacing="12" styleClass="page">
                            <Label text="Events"
                                   styleClass="page-title"/>

                            <Label text="Select a row to edit or view details. Use the top selector for event-specific tabs."
                                   wrapText="true"
                                   styleClass="muted"/>

                            <HBox spacing="10">
                                <Button text="View details"
                                        onAction="#onViewEvent"/>

                                <HBox fx:id="eventAdminBar" spacing="10">
                                    <Button text="Create event"
                                            onAction="#onAddEvent"
                                            styleClass="primary"/>

                                    <Button text="Edit selected"
                                            onAction="#onEditEvent"/>

                                    <Button text="Delete selected"
                                            onAction="#onDeleteEvent"
                                            styleClass="danger"/>
                                </HBox>
                            </HBox>

                            <TableView fx:id="eventsTable"
                                       VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Registrations">
                    <content>
                        <VBox spacing="12" styleClass="page">
                            <Label text="Participant registrations"
                                   styleClass="page-title"/>

                            <Label fx:id="registrationHint"
                                   wrapText="true"
                                   styleClass="muted"/>

                            <HBox spacing="10">
                                <Button fx:id="registerButton"
                                        text="Register for selected event"
                                        onAction="#onRegisterEvent"
                                        styleClass="primary"/>

                                <Button text="Cancel registration"
                                        onAction="#onCancelRegistration"
                                        styleClass="danger"/>

                                <Button fx:id="attendanceButton"
                                        text="Toggle attendance"
                                        onAction="#onToggleAttendance"/>
                            </HBox>

                            <TableView fx:id="registrationsTable"
                                       VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Schedule">
                    <content>
                        <VBox spacing="12" styleClass="page">
                            <Label text="Event schedule"
                                   styleClass="page-title"/>

                            <Label text="Sessions take place on the event date. Times use 24-hour HH:mm format."
                                   wrapText="true"
                                   styleClass="muted"/>

                            <HBox fx:id="scheduleAdminBar" spacing="10">
                                <Button text="Add session"
                                        onAction="#onAddSlot"
                                        styleClass="primary"/>

                                <Button text="Edit selected"
                                        onAction="#onEditSlot"/>

                                <Button text="Delete selected"
                                        onAction="#onDeleteSlot"
                                        styleClass="danger"/>
                            </HBox>

                            <TableView fx:id="scheduleTable"
                                       VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Tasks">
                    <content>
                        <VBox spacing="12" styleClass="page">
                            <Label text="Task coordination"
                                   styleClass="page-title"/>

                            <Label fx:id="taskHint"
                                   wrapText="true"
                                   styleClass="muted"/>

                            <HBox spacing="10">
                                <HBox fx:id="taskAdminBar" spacing="10">
                                    <Button text="Assign task"
                                            onAction="#onAddJob"
                                            styleClass="primary"/>

                                    <Button text="Edit selected"
                                            onAction="#onEditJob"/>

                                    <Button text="Delete selected"
                                            onAction="#onDeleteJob"
                                            styleClass="danger"/>
                                </HBox>

                                <Button text="Complete / reopen selected"
                                        onAction="#onToggleJob"/>
                            </HBox>

                            <TableView fx:id="tasksTable"
                                       VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Leaderboard">
                    <content>
                        <VBox spacing="12" styleClass="page">
                            <Label text="Event leaderboard"
                                   styleClass="page-title"/>

                            <Label text="Score = 10 attendance points + completed task points. Equal scores share a rank."
                                   wrapText="true"
                                   styleClass="muted"/>

                            <TableView fx:id="leaderboardTable"
                                       VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Planning &amp; JSON">
                    <content>
                        <VBox spacing="12" styleClass="page">
                            <Label text="Holiday planning and JSON tools"
                                   styleClass="page-title"/>

                            <Label text="Check public holidays before choosing an event date. API provider: Nager.Date."
                                   wrapText="true"
                                   styleClass="muted"/>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Country:"/>

                                <TextField fx:id="countryField"
                                           text="US"
                                           prefWidth="70"/>

                                <Label text="Year:"/>

                                <TextField fx:id="yearField"
                                           prefWidth="90"/>

                                <Button text="Fetch holidays"
                                        onAction="#onFetchHolidays"
                                        styleClass="primary"/>

                                <Button text="Load holiday JSON"
                                        onAction="#onLoadHolidays"/>

                                <Button text="Export events JSON"
                                        onAction="#onExportEvents"/>
                            </HBox>

                            <Label text="Country examples: US, GB, DE. Local holiday JSON uses the same array structure as the API response."
                                   wrapText="true"
                                   styleClass="muted"/>

                            <TableView fx:id="holidaysTable"
                                       VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </content>
                </Tab>

            </tabs>
        </TabPane>
    </center>

    <bottom>
        <Label fx:id="statusLabel"
               text="Ready"
               maxWidth="Infinity"
               styleClass="status-bar"/>
    </bottom>

</BorderPane>
